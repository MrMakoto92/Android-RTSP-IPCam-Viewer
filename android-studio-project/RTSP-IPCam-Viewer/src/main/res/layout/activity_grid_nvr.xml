<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F141C">

    <!-- Barra Superior Limpia -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#18202C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Orion NVR"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Botón con Icono de Grid para abrir ventana flotante de selección -->
        <ImageButton
            android:id="@+id/btn_open_grid_dialog"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/tv_item_selector"
            android:clickable="true"
            android:contentDescription="Seleccionar Rejilla"
            android:focusable="true"
            android:padding="8dp"
            android:src="@android:drawable/ic_dialog_dialer"
            app:tint="#00E5FF" />

    </LinearLayout>

    <!-- Sidebar Lateral -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="60dp"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_alignParentStart="true"
        android:background="#121822"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- Icono de Grid en lugar de Cámara -->
        <ImageButton
            android:id="@+id/btn_nav_cameras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/tv_item_selector"
            android:clickable="true"
            android:contentDescription="Vista Rejilla"
            android:focusable="true"
            android:src="@android:drawable/ic_dialog_dialer"
            app:tint="#00E5FF" />

        <!-- Botón Más (+) abre menú para añadir cámara -->
        <ImageButton
            android:id="@+id/btn_nav_add_nvr"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/tv_item_selector"
            android:clickable="true"
            android:contentDescription="Agregar Cámara"
            android:focusable="true"
            android:src="@android:drawable/ic_input_add"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btn_nav_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/tv_item_selector"
            android:clickable="true"
            android:contentDescription="Ajustes"
            android:focusable="true"
            android:src="@android:drawable/ic_menu_preferences"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Rejilla de Vídeo -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/camera_grid_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/top_bar"
        android:layout_toEndOf="@id/sidebar"
        android:clipToPadding="false"
        android:padding="2dp" />

</RelativeLayout>
