<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F141C"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Panel Izquierdo: Métodos de Conexión -->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:background="#121822"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Añadir Dispositivo"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_tab_onvif"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/tv_item_selector"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:text="Escanear ONVIF (Auto)"
            android:textColor="#00E5FF" />

        <Button
            android:id="@+id/btn_tab_rtsp"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/tv_item_selector"
            android:gravity="start|center_vertical"
            android:paddingStart="12dp"
            android:text="RTSP / NVR Manual"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_close_add"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/tv_item_selector"
            android:text="Volver al NVR"
            android:textColor="#FF5252" />
    </LinearLayout>

    <!-- Panel Derecho: Formulario Completo -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Configuración Avanzada de Stream"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_cam_alias"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="12dp"
                android:background="#1A222D"
                android:hint="Nombre Cámara / NVR (Ej: Entrada Principal)"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#506070" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_cam_ip"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="2"
                    android:background="#1A222D"
                    android:hint="IP / Host (Ej: 192.168.1.100)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#506070" />

                <EditText
                    android:id="@+id/input_cam_port"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#1A222D"
                    android:hint="Puerto RTSP (554)"
                    android:inputType="number"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#506070" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/input_cam_user"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:background="#1A222D"
                    android:hint="Usuario (admin)"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#506070" />

                <EditText
                    android:id="@+id/input_cam_pass"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#1A222D"
                    android:hint="Contraseña"
                    android:inputType="textPassword"
                    android:padding="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#506070" />
            </LinearLayout>

            <EditText
                android:id="@+id/input_cam_path"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="10dp"
                android:background="#1A222D"
                android:hint="Ruta / Token de Stream (Ej: /h264Preview_01_main o /Streaming/Channels/101)"
                android:padding="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#506070" />

            <Button
                android:id="@+id/btn_save_custom_cam"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/tv_item_selector"
                android:text="Guardar e Conectar Stream"
                android:textColor="#00E5FF" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
