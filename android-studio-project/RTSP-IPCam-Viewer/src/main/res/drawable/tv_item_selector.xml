<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado enfocado con el D-Pad del control remoto -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F00E5FF" />
            <stroke android:width="3dp" android:color="#00E5FF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    
    <!-- Estado presionado (OK / Enter) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3300E5FF" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <!-- Estado normal -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
